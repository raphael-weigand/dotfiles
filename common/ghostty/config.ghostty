# Shared Ghostty configuration (macOS + Linux)
# theme = catppuccin-mocha
theme = gruber darker
font-size = 16
font-family = Iosevka Term Extended
shell-integration-features = no-cursor,sudo,no-title,ssh-env,ssh-terminfo
window-padding-balance = true
window-save-state = always
copy-on-select = clipboard
cursor-style = block
cursor-style-blink = true
clipboard-paste-protection = false
clipboard-read = allow
clipboard-write = allow

# Clipboard
keybind = ctrl+v=paste_from_clipboard

# Splits
keybind = ctrl+t>shift+5=new_split:right
keybind = ctrl+t>shift+2=new_split:down
keybind = ctrl+t>j=goto_split:bottom
keybind = ctrl+t>k=goto_split:top
keybind = ctrl+t>h=goto_split:left
keybind = ctrl+t>l=goto_split:right
keybind = ctrl+t>z=toggle_split_zoom
keybind = ctrl+t>e=equalize_splits

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig
