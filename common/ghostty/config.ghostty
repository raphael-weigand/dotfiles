# Shared Ghostty configuration (macOS + Linux)
# theme = Catppuccin Mocha
theme = Gruber Darker
font-size = 16
font-family = Iosevka Term Extended
shell-integration-features = no-cursor,sudo,no-title,ssh-env,ssh-terminfo
window-padding-balance = true
window-save-state = always
copy-on-select = clipboard
cursor-style = block
cursor-style-blink = true
clipboard-paste-protection = false
clipboard-read = allow
clipboard-write = allow

# Clipboard
keybind = ctrl+v=paste_from_clipboard

# Let macOS-style Option/Level3 combinations pass through to applications.
# Ghostty binds Alt+1..9 to tab navigation by default, which conflicts with
# the German Macintosh layout (e.g. Option+5=[ and Option+8={).
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind

# Ghostty currently sends Option+N as ESC+n instead of processing the
# German Macintosh dead-tilde key. Emit a literal tilde in the terminal.
keybind = alt+n=text:~

# Splits
keybind = ctrl+t>shift+5=new_split:right
keybind = ctrl+t>shift+2=new_split:down
keybind = ctrl+t>j=goto_split:bottom
keybind = ctrl+t>k=goto_split:top
keybind = ctrl+t>h=goto_split:left
keybind = ctrl+t>l=goto_split:right
keybind = ctrl+t>z=toggle_split_zoom
keybind = ctrl+t>e=equalize_splits

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig
