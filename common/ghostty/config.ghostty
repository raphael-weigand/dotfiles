# Shared Ghostty configuration (macOS + Linux)
# theme = Catppuccin Mocha
theme = Gruber Darker
font-size = 16
font-family = Iosevka Term Extended
shell-integration-features = no-cursor,sudo,no-title,ssh-env,ssh-terminfo
window-padding-balance = true
window-save-state = always
copy-on-select = clipboard
cursor-style = block
cursor-style-blink = true
clipboard-paste-protection = false
clipboard-read = allow
clipboard-write = allow

# Pass all standard Ghostty shortcuts through to terminal applications.
# Keep the explicit Alt+N translation for the German Mac keyboard.
keybind = clear
keybind = alt+n=text:~

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig
