autoload -Uz compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes
zstyle ':completion:*' list-dirs-first true
zstyle ':completion:*' squeeze-slashes true
# zstyle ':completion:*' special-dirs true
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*:corrections' format 'Did you mean: %B%d%b'
zstyle ':completion:*' matcher-list \
  'm:{a-z}={A-Za-z}' \
  'r:|=*' \
  'l:|=* r:|=*'

zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

zmodload zsh/complist

# Keep the completion dump in the cache directory. Rebuild it once per day;
# otherwise let compinit trust the existing dump and skip its security scan.
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
ZSH_COMPDUMP="$ZSH_CACHE_DIR/zcompdump-${ZSH_VERSION}"
mkdir -p "$ZSH_CACHE_DIR"

if [[ ! -s "$ZSH_COMPDUMP" || "$ZSH_COMPDUMP" -ot "$ZSH_CACHE_DIR" ]]; then
  compinit -d "$ZSH_COMPDUMP"
  touch "$ZSH_CACHE_DIR"
else
  compinit -C -d "$ZSH_COMPDUMP"
fi

_comp_options+=(globdots)

# zsh-autosuggestions: use fixed install paths to avoid spawning Homebrew
# during every shell startup.
if [ -s /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  . /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [ -s /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  . /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [ -s /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  . /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [ -s /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  . /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
