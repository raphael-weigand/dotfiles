# Resolve the dotfiles repository from this file's symlink when possible.
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

[ -s "$DOTFILES_DIR/zsh/autocomplete" ] && . "$DOTFILES_DIR/zsh/autocomplete"
[ -s "$DOTFILES_DIR/zsh/myalias" ] && . "$DOTFILES_DIR/zsh/myalias"
[ -s "$DOTFILES_DIR/zsh/prompt" ] && . "$DOTFILES_DIR/zsh/prompt"
[ -s "$DOTFILES_DIR/zsh/nvm_bash_completion" ] && . "$DOTFILES_DIR/zsh/nvm_bash_completion"
[ -s "$DOTFILES_DIR/zsh/history" ] && . "$DOTFILES_DIR/zsh/history"

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export PATH="$PATH:$HOME/.dotnet/tools"
