DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
ZSH_COMMON="$DOTFILES_DIR/common/zsh"

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

[ -s "$ZSH_COMMON/autocomplete" ] && . "$ZSH_COMMON/autocomplete"
[ -s "$ZSH_COMMON/myalias" ] && . "$ZSH_COMMON/myalias"
[ -s "$ZSH_COMMON/history" ] && . "$ZSH_COMMON/history"
[ -s "$ZSH_COMMON/git-prompt" ] && . "$ZSH_COMMON/git-prompt"
[ -s "$ZSH_COMMON/prompt" ] && . "$ZSH_COMMON/prompt"

# Shell editing: keep Ctrl-V available to terminal applications such as Neovim,
# but make it paste from the system clipboard while editing the zsh prompt.
ctrl_v_paste() {
    local text

    if command -v wl-paste >/dev/null 2>&1; then
        text="$(wl-paste --no-newline)"
    elif command -v pbpaste >/dev/null 2>&1; then
        text="$(pbpaste)"
    else
        zle -M "No clipboard reader found (wl-paste/pbpaste)"
        return 1
    fi

    LBUFFER+="$text"
}
zle -N ctrl_v_paste
bindkey '^V' ctrl_v_paste

# PC-style word editing/navigation in the zsh prompt.
# Treat punctuation/path separators as word boundaries, like typical GUI editors.
WORDCHARS=''

bindkey '^[[1;5D' backward-word       # Ctrl-Left
bindkey '^[[1;5C' forward-word        # Ctrl-Right
bindkey '^[[3;5~' kill-word           # Ctrl-Delete
bindkey '^H' backward-kill-word        # Ctrl-Backspace

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export PATH="$PATH:$HOME/.dotnet/tools"

# fnm is relatively expensive because "fnm env" starts an external process.
# Initialize it only when a Node-related command is used for the first time.
# After initialization, fnm's --use-on-cd hook handles directory changes normally.
_lazy_load_fnm() {
    unset -f fnm node npm npx corepack _lazy_load_fnm

    if (( ! $+commands[fnm] )); then
        print -u2 "fnm: command not found"
        return 127
    fi

    eval "$($commands[fnm] env --use-on-cd --shell zsh)"
}

fnm()     { _lazy_load_fnm && fnm "$@"; }
node()    { _lazy_load_fnm && node "$@"; }
npm()     { _lazy_load_fnm && npm "$@"; }
npx()     { _lazy_load_fnm && npx "$@"; }
corepack(){ _lazy_load_fnm && corepack "$@"; }
