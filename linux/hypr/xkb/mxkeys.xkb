xkb_keymap {
    xkb_keycodes {
        include "evdev+aliases(qwertz)"
    };

    xkb_types {
        include "complete"
    };

    xkb_compat {
        include "complete"
    };

    xkb_symbols {
        // NORMAL German PC keyboard. No mac variant.
        include "pc+de+inet(evdev)"

        // Caps Lock behaves as Escape.
        replace key <CAPS> { [ Escape ] };

        // Remove original real-modifier assignments only where necessary.
        modifier_map None { <LALT>, <RALT>, <LWIN>, <RCTL> };

        // MX Keys Mini physical labels:
        replace key <LALT> { [ Super_L ] };          // L-CMD
        replace key <RALT> { [ Super_R ] };          // R-CMD
        replace key <LWIN> { [ Alt_L ] };            // L-OPT

        // R-OPT behaves exactly like a normal XKB AltGr key.
        // Do NOT manually assign Mod5 here.
        replace key <RCTL> {
            type[Group1] = "ONE_LEVEL",
            symbols[Group1] = [ ISO_Level3_Shift ]
        };

        modifier_map Mod4 { <LALT>, <RALT> };
        modifier_map Mod1 { <LWIN> };
    };

    xkb_geometry {
        include "pc(pc105)"
    };
};
