# Mako notification daemon
# Dark theme matching the Hyprland / Gruber Darker setup.

font=Iosevka Term Extended 11
background-color=#181818
text-color=#e4e4ef
border-color=#ffdd33
border-size=2
border-radius=8

width=360
height=120
margin=12
padding=12

anchor=top-right
layer=overlay

icons=1
max-icon-size=48

default-timeout=5000
ignore-timeout=0

[urgency=low]
border-color=#606060
default-timeout=3000

[urgency=critical]
border-color=#ff5555
default-timeout=0
