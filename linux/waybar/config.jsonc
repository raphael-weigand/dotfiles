{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["battery", "custom/control-center"],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },
  "clock": {
    "format": "{:%a %d.%m.  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "battery": {
    "states": {"warning": 30, "critical": 15},
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "custom/control-center": {
    "format": "󰒓",
    "tooltip": true,
    "tooltip-format": "Control Center",
    "on-click": "bash ~/.config/quickshell/toggle.sh"
  }
}
