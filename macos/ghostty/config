# theme = catppuccin-mocha
theme = gruber darker
font-size = 16
font-family = Iosevka Term Extended
shell-integration-features=no-cursor,sudo,no-title
window-padding-balance = true
window-save-state = always
window-colorspace = "display-p3"
copy-on-select=clipboard
cursor-style = block
cursor-style-blink = true
macos-option-as-alt = false
clipboard-paste-protection = false
clipboard-read = allow
clipboard-write = allow

# split
keybind = ctrl+t>shift+5=new_split:right
keybind = ctrl+t>shift+2=new_split:down
keybind = ctrl+t>j=goto_split:bottom
keybind = ctrl+t>k=goto_split:top
keybind = ctrl+t>h=goto_split:left
keybind = ctrl+t>l=goto_split:right
keybind = ctrl+t>z=toggle_split_zoom
keybind = ctrl+t>e=equalize_splits

### disabile ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig