# Git status segment for the macOS zsh prompt.
# Example: [development ↑1 ↓2 ~1 ?2]
#
# ↑ commits ahead of upstream
# ↓ commits behind upstream
# + staged changes
# ~ modified (unstaged) files
# - deleted (unstaged) files
# ? untracked files
#
# Counters with value 0 are omitted.

git_prompt_segment() {
    command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

    local branch git_status segment upstream_counts
    local ahead=0 behind=0 staged=0 modified=0 deleted=0 untracked=0

    branch="$(command git symbolic-ref --quiet --short HEAD 2>/dev/null \
        || command git rev-parse --short HEAD 2>/dev/null)"

    # Compare HEAD with the configured upstream branch. This uses only the
    # locally known remote state and deliberately does not run git fetch.
    if command git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
        upstream_counts="$(command git rev-list --left-right --count HEAD...'@{upstream}' 2>/dev/null)"
        if [ -n "$upstream_counts" ]; then
            read -r ahead behind <<< "$upstream_counts"
        fi
    fi

    git_status="$(command git status --porcelain 2>/dev/null)"

    while IFS= read -r line; do
        [ -z "$line" ] && continue

        local x="${line[1,1]}"
        local y="${line[2,2]}"

        if [ "$x" = "?" ] && [ "$y" = "?" ]; then
            (( untracked++ ))
            continue
        fi

        [ "$x" != " " ] && (( staged++ ))

        case "$y" in
            M|T) (( modified++ )) ;;
            D)   (( deleted++ )) ;;
        esac
    done <<< "$git_status"

    segment="%F{cyan}[$branch"
    (( ahead > 0 )) && segment+=" ↑$ahead"
    (( behind > 0 )) && segment+=" ↓$behind"
    (( staged > 0 )) && segment+=" +$staged"
    (( modified > 0 )) && segment+=" ~$modified"
    (( deleted > 0 )) && segment+=" -$deleted"
    (( untracked > 0 )) && segment+=" ?$untracked"
    segment+="]%f"

    printf ' %s' "$segment"
}
