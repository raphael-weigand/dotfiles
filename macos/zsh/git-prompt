# Git status segment for the macOS zsh prompt.
# Example: [development ≡ +0 ~1 -0 ?0]
#
# + staged changes
# ~ modified (unstaged) files
# - deleted (unstaged) files
# ? untracked files

git_prompt_segment() {
    command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

    local branch git_status
    local staged=0 modified=0 deleted=0 untracked=0

    branch="$(command git symbolic-ref --quiet --short HEAD 2>/dev/null \
        || command git rev-parse --short HEAD 2>/dev/null)"

    git_status="$(command git status --porcelain 2>/dev/null)"

    while IFS= read -r line; do
        [ -z "$line" ] && continue

        local x="${line[1,1]}"
        local y="${line[2,2]}"

        if [ "$x" = "?" ] && [ "$y" = "?" ]; then
            (( untracked++ ))
            continue
        fi

        [ "$x" != " " ] && (( staged++ ))

        case "$y" in
            M|T) (( modified++ )) ;;
            D)   (( deleted++ )) ;;
        esac
    done <<< "$git_status"

    printf ' %%F{cyan}[%s ≡ +%d ~%d -%d ?%d]%%f' \
        "$branch" "$staged" "$modified" "$deleted" "$untracked"
}
