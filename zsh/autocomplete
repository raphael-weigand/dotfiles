autoload -Uz compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list \
'm:{a-z}={A-Za-z}' \
'r:|=*' \
'l:|=* r:|=*'zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

zmodload zsh/complist
compinit -C
_comp_options+=(globdots)
[ -s "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \. "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" # load the autocomplete 
