export EDITOR='nvim'
export VISUAL='nvim'
export PAGER='less'

# Homebrew on Intel macOS.
export PATH="/usr/local/bin:/usr/local/sbin:$PATH"

# User binaries.
export PATH="$HOME/.local/bin:$PATH"
export PATH="/usr/local/opt/trash/bin:$PATH"

# .NET: use Homebrew's stable opt symlink instead of a versioned Cellar path.
if [ -d "/usr/local/opt/dotnet/libexec" ]; then
    export DOTNET_ROOT="/usr/local/opt/dotnet/libexec"
    export PATH="$DOTNET_ROOT:$PATH"
fi

# Terminal colors. TERM is deliberately left to Ghostty/tmux.
export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad

# Homebrew behavior.
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_BAT=1
export HOMEBREW_COLOR=1
export HOMEBREW_CASK_OPTS="--appdir=/Applications"

# Aliases.
alias rm="trash"
alias la="ls -lah"
alias ll="ls -lh"

alias sync="echo 'brew update...'; brew update -v"
alias upgrade="echo 'brew upgrade...'; brew upgrade; echo 'brew cleanup...'; brew cleanup -s; echo 'brew autoremove...'; brew autoremove"

alias flushdns="echo 'sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder...'; sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"

alias cputemp="sudo powermetrics --samplers smc | grep -i -E 'die temperature|fan'"
alias powerinfo="sudo powermetrics"

# Attach to the main session or create it in the programming directory.
alias tmx="tmux new-session -A -s main -c ~/Programming/"

# Better defaults if installed.
# command -v eza >/dev/null 2>&1 && alias ls="eza"
# command -v bat >/dev/null 2>&1 && alias cat="bat"

setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
